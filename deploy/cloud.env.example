# Copy to a private file outside Git, for example deploy/cloud.env.
# 2026-10-13: point DNS to the server before starting Caddy.
POSTGRES_PASSWORD=replace-with-a-long-random-production-password
API_CLIENT_ID=replace-with-your-api-app-registration-client-id
PUBLIC_DOMAIN=go.example.com
PUBLIC_BASE_URL=https://go.example.com/
WEB_CLIENT_ID=replace-with-your-web-app-registration-client-id
WEB_CLIENT_SECRET=replace-with-your-web-app-registration-secret
API_SCOPE=api://replace-with-your-api-app-registration-client-id/access_as_user
TENANT_ID=organizations
