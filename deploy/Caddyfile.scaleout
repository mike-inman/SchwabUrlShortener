:8080 {
    @api path /api/* /r/* /health/*
    handle @api {
        reverse_proxy {
            dynamic a api 8080 {
                refresh 1s
            }
            lb_policy round_robin
            fail_duration 5s
            lb_try_duration 5s
        }
    }
    handle {
        reverse_proxy {
            dynamic a web 8080 {
                refresh 1s
            }
            lb_policy cookie
            fail_duration 5s
            lb_try_duration 5s
        }
    }
}
