# Copy to a private file outside Git, for example deploy/local.env.
# 2026-10-13: local machine defaults. Change the password and API client ID.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
PUBLIC_BASE_URL=http://localhost:8080/
LOCAL_PORT=8080
# Managed sign-in is disabled until all three values are provided.
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
API_SCOPE=
TENANT_ID=organizations
