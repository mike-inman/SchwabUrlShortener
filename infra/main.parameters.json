{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "${AZURE_LOCATION}" },
    "postgresPassword": { "value": "${POSTGRES_PASSWORD}" },
    "apiClientId": { "value": "${API_CLIENT_ID}" },
    "budgetContactEmail": { "value": "${BUDGET_CONTACT_EMAIL}" },
    "customDomain": { "value": "${CUSTOM_DOMAIN}" },
    "redisSku": { "value": "${REDIS_SKU}" },
    "apiImage": { "value": "${SERVICE_API_IMAGE}" },
    "webImage": { "value": "${SERVICE_WEB_IMAGE}" },
    "analyticsImage": { "value": "${SERVICE_ANALYTICS_IMAGE}" },
    "deploymentPhase": { "value": "${DEPLOYMENT_PHASE}" }
  }
}
