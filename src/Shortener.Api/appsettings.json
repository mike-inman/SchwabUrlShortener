{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "Mode": "Filesystem",
    "ApplicationName": "Shortener.Api"
  },
  "LiveUpdates": {
    "Mode": "Redis",
    "Channel": "shortener:links:v1",
    "DebounceMilliseconds": 1000
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "organizations"
  }
}
