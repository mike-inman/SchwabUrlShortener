@page "/"
@inject IShortenerApiClient Api
@inject ILogger<Home> Logger

<PageTitle>@BrandText.TitleSuffix · @BrandText.Tagline</PageTitle>
<section class="zl-hero" aria-labelledby="hero-title">
    <p class="zl-eyebrow">@BrandText.Tagline</p>
    <h1 id="hero-title">Every link deserves a <em>smarter destination.</em></h1>
    <p class="lead">Create short links, track engagement, and manage your links from one dashboard.</p>
    <div class="zl-demo zl-panel" aria-hidden="true">
        <span class="zl-demo-label">Example</span>
        <span class="zl-demo-long">https://www.example.com/campaigns/2026/autumn-launch?utm_source=newsletter&amp;utm_medium=email&amp;utm_campaign=launch</span>
        <span class="zl-demo-route">
            <svg viewBox="0 0 40 24"><path d="M3 4H33L9 20H37"/></svg>
            <span class="zl-chip">ziplio.io/launch</span>
        </span>
    </div>
    <ul class="zl-proof">
        <li>Secure links</li><li>Live click counts</li><li>Built for reliability</li>
    </ul>
</section>
<section aria-labelledby="guest-title">
<h2 id="guest-title">Try a guest link</h2>
<p class="lead">Share a short redirect link without signing in. It expires seven days after creation.</p>
<p>Guest links are redirect only. They have no analytics or management dashboard.</p>

<EditForm Model="form" OnSubmit="CreateAsync" FormName="guest-link" class="link-form">
    <label for="guest-url">Destination URL</label>
    <InputText id="guest-url" class="form-control" type="url" required pattern="https?://.+" title="@CreateLinkFormValidation.UrlMessage" placeholder="https://example.com/page" autofocus="@focusDestination" aria-invalid="@(fieldErrors.DestinationUrl is not null ? "true" : null)" aria-describedby="@(fieldErrors.DestinationUrl is not null ? "guest-url-browser-error guest-url-error" : "guest-url-browser-error")" @bind-Value="form.OriginalUrl" />
    <p id="guest-url-browser-error" class="field-error browser-validation" role="alert">@CreateLinkFormValidation.UrlMessage</p>
    @if (fieldErrors.DestinationUrl is not null) { <p id="guest-url-error" class="field-error" role="alert">@fieldErrors.DestinationUrl</p> }
    <label for="guest-code">Custom short code</label>
    <InputText id="guest-code" class="form-control" pattern="[A-Za-z0-9]{4,12}" maxlength="12" title="@CreateLinkFormValidation.CodeMessage" aria-invalid="@(fieldErrors.ShortCode is not null ? "true" : null)" aria-describedby="@(fieldErrors.ShortCode is not null ? "guest-code-hint guest-code-browser-error guest-code-error" : "guest-code-hint guest-code-browser-error")" @bind-Value="form.ShortCode" />
    <p id="guest-code-hint" class="field-hint">4–12 letters or numbers (optional)</p>
    <p id="guest-code-browser-error" class="field-error browser-validation" role="alert">@CreateLinkFormValidation.CodeMessage</p>
    @if (fieldErrors.ShortCode is not null) { <p id="guest-code-error" class="field-error" role="alert">@fieldErrors.ShortCode</p> }
    <button class="btn btn-primary" type="submit" disabled="@busy">@(busy ? "Creating…" : "Create guest link")</button>
</EditForm>

@if (busy) { <p role="status">Creating your link…</p> }
@if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
@if (created is not null)
{
    <section class="result" role="status">
        <h2>Guest link ready</h2>
        <p><a href="@created.PublicUrl" target="_blank" rel="noopener noreferrer">@created.PublicUrl</a>
            <button type="button" class="copy-link btn btn-sm btn-outline-primary ms-2" data-copy-text="@created.PublicUrl" aria-label="Copy short link @created.Link.ShortCode">
                <svg class="copy-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>
                <svg class="copy-check" aria-hidden="true" hidden viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m4 12 5 5L20 6"/></svg>
                <span class="copy-label">Copy</span>
            </button><span class="visually-hidden copy-announcement" aria-live="polite"></span>
        </p>
        <p>Expires: @created.Link.ExpiresAtUtc?.ToLocalTime().ToString("f")</p>
        <p class="muted">Save this link now. Guest links have no analytics or management controls.</p>
    </section>
}
</section>

@code {
    [SupplyParameterFromForm(Name = "form", FormName = "guest-link")]
    private LinkForm? submittedForm { get; set; }
    private LinkForm form => submittedForm ??= new();
    private bool busy;
    private string? error;
    private LinkResult? created;
    private CreateLinkFormErrors fieldErrors = new();
    private bool focusDestination;

    private async Task CreateAsync()
    {
        error = null;
        created = null;
        focusDestination = false;
        fieldErrors = CreateLinkFormValidation.Validate(form.OriginalUrl, form.ShortCode);
        if (fieldErrors.HasErrors) return;
        busy = true;
        try
        {
            created = await Api.CreateGuestAsync(new(form.OriginalUrl, string.IsNullOrEmpty(form.ShortCode) ? null : form.ShortCode));
            submittedForm = new();
            focusDestination = true;
        }
        catch (ShortenerApiException ex)
        {
            fieldErrors = CreateLinkFormValidation.FromApi(ex);
            if (!fieldErrors.HasErrors) error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError("Guest link creation failed unexpectedly. ExceptionType={ExceptionType}", ex.GetType().Name);
            error = "Unable to create the link right now. Try again later.";
        }
        finally { busy = false; }
    }

    private sealed class LinkForm
    {
        public string OriginalUrl { get; set; } = "";
        public string? ShortCode { get; set; }
    }
}
