@page "/dashboard"
@implements IAsyncDisposable
@attribute [Authorize]
@rendermode InteractiveServer
@inject IShortenerApiClient Api
@inject ILogger<Dashboard> Logger
@inject IdentityAvailability Identity
@inject NavigationManager Navigation
@inject WorkspaceNavigationState WorkspaceNavigation
@inject Shortener.Web.Services.LiveUpdates.ILinkChangeSubscriber LiveUpdates
@inject IConfiguration Configuration
@using Shortener.Application

<PageTitle>My links · @BrandText.TitleSuffix</PageTitle>
@if (notice is not null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3 dashboard-toast-container" aria-live="polite" aria-atomic="true">
        <div class="toast show dashboard-toast @notice.Kind @(noticeDismissing ? "dismissing" : null)" role="status">
            <div class="toast-header">
                <strong class="me-auto">@notice.Title</strong>
                <button type="button" class="btn-close" aria-label="Close notification" @onclick="DismissNotice"></button>
            </div>
            <div class="toast-body">@notice.MessagePrefix<strong class="dashboard-toast-code">“@notice.ShortCode”</strong>@notice.MessageSuffix</div>
        </div>
    </div>
}
<h1>My links</h1>
@if (Identity.Customer && workspaces?.Count == 1)
{
    <p class="workspace-caption muted">@workspaces[0].Name workspace</p>
}
<p class="lead">Create persistent links for your @(Identity.Customer ? "workspace" : "signed-in organization") and review redirect counts.</p>

@if (!Identity.Configured)
{
    <p class="alert alert-warning">Managed sign-in is not configured for this site.</p>
}
else
{
    <section>
        <h2>Create a managed link</h2>
        <EditForm Model="form" OnSubmit="CreateAsync" FormName="managed-link" class="link-form">
            <label for="managed-url">Destination URL</label>
            <input id="managed-url" class="form-control" type="url" required placeholder="https://example.com/page" @bind="form.OriginalUrl" />
            <label for="managed-code">Custom short code <span class="muted">(optional)</span></label>
            <input id="managed-code" class="form-control" maxlength="64" @bind="form.ShortCode" />
            <button class="btn btn-primary" type="submit" disabled="@busy">@(busy ? "Creating…" : "Create managed link")</button>
        </EditForm>
    </section>

    <section>
        <div class="section-heading"><h2>Your links</h2></div>
        @if (reauthRequired)
        {
            <p class="alert alert-warning" role="status">
                @if (Reauth == "1")
                {
                    <text>We could not restore your managed-link access. <a href="/account/signin" class="alert-link">Sign in again</a>.</text>
                }
                else
                {
                    <text>Restoring your sign-in…</text>
                }
            </p>
        }
        @if (liveUpdateError) { <p class="alert alert-warning" role="status">Live updates are temporarily unavailable. Reconnecting automatically.</p> }
        @if (busy) { <p role="status">Loading managed links…</p> }
        @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
        @if (!busy && links is not null && links.Count == 0) { <p>No managed links yet.</p> }
        @if (links is not null && links.Count > 0)
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Short link</th><th>Destination</th><th>Created</th><th>Redirects</th><th>Last 7 days</th><th>Last accessed</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var link in links)
                        {
                            <tr class="@(selected?.ShortCode == link.ShortCode ? "selected-link" : null)" aria-selected="@(selected?.ShortCode == link.ShortCode)">
                                <td><a href="@Api.PublicUrl(link.ShortCode)" target="_blank" rel="noopener noreferrer">@link.ShortCode</a></td>
                                <td class="destination">@link.OriginalUrl</td>
                                <td>@link.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@link.HitCount</td>
                                <td>
                                    @if (Identity.Customer && sparklines.TryGetValue(link.ShortCode, out var trend))
                                    {
                                        <svg class="insights-sparkline" viewBox="0 0 120 34" role="img" aria-label="Last 7 days: @string.Join(", ", trend.Select(x => x.Clicks)) clicks">
                                            <polyline fill="none" stroke="@(trend.Count > 1 && trend[^1].Clicks >= trend[0].Clicks ? "#59E6CF" : "#7C93B8")" stroke-width="2.5" points="@SparkPoints(trend)" />
                                        </svg>
                                    }
                                    else { <span class="muted">—</span> }
                                </td>
                                <td>@(link.LastAccessedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                                <td><div class="link-row-actions"><button class="btn btn-sm btn-outline-primary" disabled="@busy" aria-label="Details for @link.ShortCode" @onclick="() => ShowDetailsAsync(link.ShortCode)">Details</button>
                                    @if (Identity.Customer) { <a class="btn btn-sm btn-outline-primary" href="@($"/dashboard/links/{Uri.EscapeDataString(link.ShortCode)}/insights")">Insights</a> }</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    @if (selected is not null)
    {
        <section class="result">
            <h2>Details for <a href="@Api.PublicUrl(selected.ShortCode)" target="_blank" rel="noopener noreferrer">@selected.ShortCode</a></h2>
            <p>Destination: @selected.OriginalUrl</p>
            <p>Redirects: @selected.HitCount</p>
            <p>Last accessed: @(selected.LastAccessedAtUtc?.ToLocalTime().ToString("f") ?? "Never")</p>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "reauth")] private string? Reauth { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    private readonly LinkForm form = new();
    private IReadOnlyList<ManagedLink>? links;
    private Dictionary<string, IReadOnlyList<InsightPoint>> sparklines = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<WorkspaceSummary>? workspaces;
    private Guid? workspaceId;
    private ManagedLink? selected;
    private ToastNotice? notice;
    private bool noticeDismissing;
    private CancellationTokenSource? noticeCancellation;
    private bool busy;
    private bool liveUpdateError;
    private bool reauthRequired;
    private bool renewalStarted;
    private bool renewalReturnCleared;
    private string? error;
    private readonly CancellationTokenSource liveCancellation = new();
    private IDisposable? liveSubscription;
    private CancellationTokenSource? pendingRefreshCancellation;
    private Task? pendingRefreshTask;
    private bool refreshPending;

    protected override async Task OnInitializedAsync()
    {
        if (Identity.Configured) await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Reauth == "1" && !reauthRequired && !renewalReturnCleared)
        {
            renewalReturnCleared = true;
            Navigation.NavigateTo("/dashboard", forceLoad: true, replace: true);
        }
        else if (reauthRequired && Reauth != "1" && !renewalStarted)
        {
            renewalStarted = true;
            Navigation.NavigateTo("/account/renew", forceLoad: true);
        }
        else if (firstRender && Identity.Configured && !reauthRequired)
            await SubscribeAsync();
    }

    private async Task SubscribeAsync()
    {
        LinkChangeScope scope;
        Guid id;
        if (Identity.Customer)
        {
            if (workspaceId is not { } selectedId || workspaces?.Any(x => x.Id == selectedId) != true) return;
            scope = LinkChangeScope.Workspace;
            id = selectedId;
        }
        else
        {
            var user = (await AuthenticationState).User;
            if (user.Identity?.IsAuthenticated != true) return;
            var tenant = user.FindFirst("tid")?.Value ??
                user.FindFirst("http://schemas.microsoft.com/identity/claims/tenantid")?.Value;
            if (!Guid.TryParse(tenant, out id) || id == Guid.Empty) return;
            scope = LinkChangeScope.Tenant;
        }
        CancelPendingRefresh();
        liveSubscription?.Dispose();
        liveSubscription = LiveUpdates.Subscribe(scope, id, () => InvokeAsync(QueueRefresh));
        LiveUpdates.ConnectionChanged -= OnConnectionChanged;
        LiveUpdates.ConnectionChanged += OnConnectionChanged;
        liveUpdateError = !LiveUpdates.IsConnected;
        StateHasChanged();
    }

    private void OnConnectionChanged(bool connected) => _ = InvokeAsync(() =>
    {
        liveUpdateError = !connected;
        StateHasChanged();
    });

    private void QueueRefresh()
    {
        if (liveCancellation.IsCancellationRequested || reauthRequired || refreshPending) return;
        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(liveCancellation.Token);
        pendingRefreshCancellation = cancellation;
        refreshPending = true;
        pendingRefreshTask = ThrottleAsync(cancellation);
    }

    private void CancelPendingRefresh()
    {
        pendingRefreshCancellation?.Cancel();
        pendingRefreshCancellation = null;
        refreshPending = false;
    }

    private async Task ThrottleAsync(CancellationTokenSource cancellation)
    {
        try
        {
            var milliseconds = int.Parse(Configuration["LiveUpdates:DebounceMilliseconds"]!);
            await Task.Delay(milliseconds, cancellation.Token);
            await InvokeAsync(async () =>
            {
                if (cancellation.IsCancellationRequested || !ReferenceEquals(pendingRefreshCancellation, cancellation)) return;
                pendingRefreshCancellation = null;
                refreshPending = false;
                await RefreshLiveAsync();
            });
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally { cancellation.Dispose(); }
    }

    private async Task RefreshLiveAsync()
    {
        if (busy) return;
        try
        {
            var latest = await GetLinksAsync((await AuthenticationState).User, liveCancellation.Token);
            if (Identity.Customer) await LoadSparklinesAsync((await AuthenticationState).User, liveCancellation.Token);
            var changed = links is null || !latest.SequenceEqual(links);
            links = latest;
            if (selected is not null)
                selected = latest.FirstOrDefault(link => link.ShortCode == selected.ShortCode);
            var warningChanged = liveUpdateError != !LiveUpdates.IsConnected;
            if (changed || warningChanged || Identity.Customer)
            {
                liveUpdateError = !LiveUpdates.IsConnected;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (liveCancellation.IsCancellationRequested) { }
        catch (ManagedReauthenticationRequiredException ex)
        {
            HandleFailure(ex, "refresh managed links");
            await liveCancellation.CancelAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Managed dashboard live update failed. ExceptionType={ExceptionType}", ex.GetType().Name);
            liveUpdateError = true;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        WorkspaceNavigation.Clear(SelectWorkspaceAsync);
        LiveUpdates.ConnectionChanged -= OnConnectionChanged;
        liveSubscription?.Dispose();
        CancelPendingRefresh();
        await liveCancellation.CancelAsync();
        if (pendingRefreshTask is not null)
        {
            try { await pendingRefreshTask; }
            catch (OperationCanceledException) { }
        }
        liveCancellation.Dispose();
        noticeCancellation?.Cancel();
        noticeCancellation?.Dispose();
    }

    private async Task LoadAsync()
    {
        busy = true;
        error = null;
        try
        {
            var user = (await AuthenticationState).User;
            if (Identity.Customer)
            {
                workspaces = await Api.GetWorkspacesAsync(user);
                workspaceId = workspaces.FirstOrDefault(x => x.Kind == 0)?.Id ?? workspaces.FirstOrDefault()?.Id;
                if (workspaceId is null) throw new ShortenerApiException("No workspace is available for this account.");
                WorkspaceNavigation.Configure(workspaces, workspaceId.Value, SelectWorkspaceAsync);
            }
            links = await GetLinksAsync(user);
            if (Identity.Customer) await LoadSparklinesAsync(user);
        }
        catch (Exception ex) { HandleFailure(ex, "load managed links"); }
        finally { busy = false; }
    }

    private async Task CreateAsync()
    {
        busy = true;
        error = null;
        try
        {
            var user = (await AuthenticationState).User;
            var request = new CreateLinkRequest(form.OriginalUrl, string.IsNullOrWhiteSpace(form.ShortCode) ? null : form.ShortCode.Trim());
            var result = Identity.Customer
                ? await Api.CreateWorkspaceManagedAsync(workspaceId!.Value, request, user)
                : await Api.CreateManagedAsync(request, user);
            links = await GetLinksAsync(user);
            if (Identity.Customer) await LoadSparklinesAsync(user);
            selected = links.FirstOrDefault(link => link.ShortCode == result.Link.ShortCode);
            ShowNotice(result.AlreadyExists ? "Link already exists" : "Link created",
                result.AlreadyExists ? "You already have short link " : "Short link ",
                result.Link.ShortCode,
                result.AlreadyExists ? "." : " is ready.",
                result.AlreadyExists ? "notice-info" : "notice-success");
        }
        catch (Exception ex) { HandleFailure(ex, "create managed link"); }
        finally { busy = false; }
    }

    private async Task ShowDetailsAsync(string shortCode)
    {
        busy = true;
        error = null;
        selected = null;
        try
        {
            var user = (await AuthenticationState).User;
            if (Identity.Customer)
            {
                await Api.GetWorkspaceManagedLinkAsync(workspaceId!.Value, shortCode, user);
                selected = await Api.GetWorkspaceManagedAnalyticsAsync(workspaceId.Value, shortCode, user);
            }
            else
            {
                await Api.GetManagedLinkAsync(shortCode, user);
                selected = await Api.GetManagedAnalyticsAsync(shortCode, user);
            }
        }
        catch (Exception ex) { HandleFailure(ex, "load link analytics"); }
        finally { busy = false; }
    }

    private Task<IReadOnlyList<ManagedLink>> GetLinksAsync(System.Security.Claims.ClaimsPrincipal user,
        CancellationToken cancellationToken = default) => Identity.Customer
            ? Api.GetWorkspaceManagedLinksAsync(workspaceId!.Value, user, cancellationToken)
            : Api.GetManagedLinksAsync(user, cancellationToken);

    private Task SelectWorkspaceAsync(Guid selectedId) => InvokeAsync(async () =>
    {
        if (workspaces?.Any(x => x.Id == selectedId) != true || workspaceId == selectedId) return;
        workspaceId = selectedId;
        await SubscribeAsync();
        selected = null;
        WorkspaceNavigation.SetSelected(selectedId);
        await LoadLinksAsync();
        StateHasChanged();
    });

    private async Task LoadLinksAsync()
    {
        busy = true;
        try
        {
            var user = (await AuthenticationState).User;
            links = await GetLinksAsync(user);
            if (Identity.Customer) await LoadSparklinesAsync(user);
        }
        catch (Exception ex) { HandleFailure(ex, "load workspace links"); }
        finally { busy = false; }
    }

    private async Task LoadSparklinesAsync(System.Security.Claims.ClaimsPrincipal user, CancellationToken cancellationToken = default)
    {
        if (workspaceId is not { } id) return;
        var rows = await Api.GetWorkspaceSparklinesAsync(id, 7, user, cancellationToken);
        sparklines = rows.ToDictionary(x => x.ShortCode, x => x.Days, StringComparer.OrdinalIgnoreCase);
    }

    private static string SparkPoints(IReadOnlyList<InsightPoint> trend)
    {
        if (trend.Count == 0) return string.Empty;
        var max = Math.Max(1, trend.Max(x => x.Clicks));
        return string.Join(" ", trend.Select((x, index) =>
            $"{4 + index * 112.0 / Math.Max(1, trend.Count - 1):0.#},{30 - x.Clicks * 26.0 / max:0.#}"));
    }

    private void ShowNotice(string title, string messagePrefix, string shortCode, string messageSuffix, string kind)
    {
        noticeCancellation?.Cancel();
        noticeCancellation?.Dispose();
        notice = new(title, messagePrefix, shortCode, messageSuffix, kind);
        noticeDismissing = false;
        noticeCancellation = new CancellationTokenSource();
        _ = DismissAfterDelayAsync(notice, noticeCancellation.Token);
    }

    private async Task DismissAfterDelayAsync(ToastNotice shownNotice, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6.7), cancellationToken);
            await InvokeAsync(() =>
            {
                if (ReferenceEquals(notice, shownNotice))
                {
                    noticeDismissing = true;
                    StateHasChanged();
                }
            });
            await Task.Delay(TimeSpan.FromMilliseconds(300), cancellationToken);
            await InvokeAsync(() =>
            {
                if (ReferenceEquals(notice, shownNotice))
                {
                    notice = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException) { }
    }

    private void DismissNotice()
    {
        noticeCancellation?.Cancel();
        notice = null;
    }

    private sealed record ToastNotice(string Title, string MessagePrefix, string ShortCode, string MessageSuffix, string Kind);

    private void HandleFailure(Exception ex, string operation)
    {
        if (ex is ManagedReauthenticationRequiredException)
        {
            reauthRequired = true;
            liveUpdateError = false;
            links = null;
            selected = null;
            error = null;
        }
        else if (ex is ShortenerApiException or ManagedAccessUnavailableException)
            error = ex.Message;
        else
        {
            Logger.LogError("Managed UI operation failed. Operation={Operation} ExceptionType={ExceptionType}", operation, ex.GetType().Name);
            error = "Unable to complete this operation. Try again later.";
        }
    }

    private sealed class LinkForm
    {
        public string OriginalUrl { get; set; } = "";
        public string? ShortCode { get; set; }
    }
}
