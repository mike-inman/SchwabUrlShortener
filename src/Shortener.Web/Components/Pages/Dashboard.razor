@page "/dashboard"
@implements IAsyncDisposable
@attribute [Authorize]
@rendermode InteractiveServer
@inject IShortenerApiClient Api
@inject ILogger<Dashboard> Logger
@inject IdentityAvailability Identity
@inject NavigationManager Navigation

<PageTitle>Managed links</PageTitle>
@if (notice is not null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3 dashboard-toast-container" aria-live="polite" aria-atomic="true">
        <div class="toast show dashboard-toast @notice.Kind @(noticeDismissing ? "dismissing" : null)" role="status">
            <div class="toast-header">
                <strong class="me-auto">@notice.Title</strong>
                <button type="button" class="btn-close" aria-label="Close notification" @onclick="DismissNotice"></button>
            </div>
            <div class="toast-body">@notice.MessagePrefix<strong class="dashboard-toast-code">“@notice.ShortCode”</strong>@notice.MessageSuffix</div>
        </div>
    </div>
}
<h1>Managed links</h1>
<p class="lead">Create persistent links for your signed-in organization and review redirect counts.</p>

@if (!Identity.Configured)
{
    <p class="alert alert-warning">Managed sign-in is not configured for this site.</p>
}
else
{
    <section>
        <h2>Create a managed link</h2>
        <EditForm Model="form" OnSubmit="CreateAsync" FormName="managed-link" class="link-form">
            <label for="managed-url">Destination URL</label>
            <input id="managed-url" class="form-control" type="url" required placeholder="https://example.com/page" @bind="form.OriginalUrl" />
            <label for="managed-code">Custom short code <span class="muted">(optional)</span></label>
            <input id="managed-code" class="form-control" maxlength="64" @bind="form.ShortCode" />
            <button class="btn btn-primary" type="submit" disabled="@busy">@(busy ? "Creating…" : "Create managed link")</button>
        </EditForm>
    </section>

    <section>
        <div class="section-heading"><h2>Your links</h2><span class="muted">Updates automatically</span></div>
        @if (reauthRequired)
        {
            <p class="alert alert-warning" role="status">
                @if (Reauth == "1")
                {
                    <text>We could not restore your managed-link access. <a href="/account/signin" class="alert-link">Sign in again</a>.</text>
                }
                else
                {
                    <text>Restoring your sign-in…</text>
                }
            </p>
        }
        @if (liveUpdateError) { <p class="alert alert-warning" role="status">Live updates are temporarily unavailable. Reconnecting automatically.</p> }
        @if (busy) { <p role="status">Loading managed links…</p> }
        @if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
        @if (!busy && links is not null && links.Count == 0) { <p>No managed links yet.</p> }
        @if (links is not null && links.Count > 0)
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Short link</th><th>Destination</th><th>Created</th><th>Redirects</th><th>Last accessed</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var link in links)
                        {
                            <tr class="@(selected?.ShortCode == link.ShortCode ? "selected-link" : null)" aria-selected="@(selected?.ShortCode == link.ShortCode)">
                                <td><a href="@Api.PublicUrl(link.ShortCode)" target="_blank" rel="noopener noreferrer">@link.ShortCode</a></td>
                                <td class="destination">@link.OriginalUrl</td>
                                <td>@link.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@link.HitCount</td>
                                <td>@(link.LastAccessedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                                <td><button class="btn btn-sm btn-outline-primary" disabled="@busy" aria-label="Details for @link.ShortCode" @onclick="() => ShowDetailsAsync(link.ShortCode)">Details</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    @if (selected is not null)
    {
        <section class="result">
            <h2>Details for <a href="@Api.PublicUrl(selected.ShortCode)" target="_blank" rel="noopener noreferrer">@selected.ShortCode</a></h2>
            <p>Destination: @selected.OriginalUrl</p>
            <p>Redirects: @selected.HitCount</p>
            <p>Last accessed: @(selected.LastAccessedAtUtc?.ToLocalTime().ToString("f") ?? "Never")</p>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "reauth")] private string? Reauth { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    private readonly LinkForm form = new();
    private IReadOnlyList<ManagedLink>? links;
    private ManagedLink? selected;
    private ToastNotice? notice;
    private bool noticeDismissing;
    private CancellationTokenSource? noticeCancellation;
    private bool busy;
    private bool liveUpdateError;
    private bool reauthRequired;
    private bool renewalStarted;
    private bool renewalReturnCleared;
    private string? error;
    private readonly CancellationTokenSource liveCancellation = new();
    private Task? liveTask;

    protected override async Task OnInitializedAsync()
    {
        if (Identity.Configured) await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (Reauth == "1" && !reauthRequired && !renewalReturnCleared)
        {
            renewalReturnCleared = true;
            Navigation.NavigateTo("/dashboard", forceLoad: true, replace: true);
        }
        else if (reauthRequired && Reauth != "1" && !renewalStarted)
        {
            renewalStarted = true;
            Navigation.NavigateTo("/account/renew", forceLoad: true);
        }
        else if (firstRender && Identity.Configured && !reauthRequired)
            liveTask = WatchLinksAsync();
        return Task.CompletedTask;
    }

    private async Task WatchLinksAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(liveCancellation.Token))
                await InvokeAsync(RefreshLiveAsync);
        }
        catch (OperationCanceledException) when (liveCancellation.IsCancellationRequested) { }
    }

    private async Task RefreshLiveAsync()
    {
        if (busy) return;
        try
        {
            var latest = await Api.GetManagedLinksAsync((await AuthenticationState).User, liveCancellation.Token);
            var changed = links is null || !latest.SequenceEqual(links);
            links = latest;
            if (selected is not null)
                selected = latest.FirstOrDefault(link => link.ShortCode == selected.ShortCode);
            if (changed || liveUpdateError)
            {
                liveUpdateError = false;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (liveCancellation.IsCancellationRequested) { }
        catch (ManagedReauthenticationRequiredException ex)
        {
            HandleFailure(ex, "refresh managed links");
            await liveCancellation.CancelAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning("Managed dashboard live update failed. ExceptionType={ExceptionType}", ex.GetType().Name);
            liveUpdateError = true;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await liveCancellation.CancelAsync();
        if (liveTask is not null)
        {
            try { await liveTask; }
            catch (OperationCanceledException) { }
        }
        liveCancellation.Dispose();
        noticeCancellation?.Cancel();
        noticeCancellation?.Dispose();
    }

    private async Task LoadAsync()
    {
        busy = true;
        error = null;
        try { links = await Api.GetManagedLinksAsync((await AuthenticationState).User); }
        catch (Exception ex) { HandleFailure(ex, "load managed links"); }
        finally { busy = false; }
    }

    private async Task CreateAsync()
    {
        busy = true;
        error = null;
        try
        {
            var user = (await AuthenticationState).User;
            var result = await Api.CreateManagedAsync(new(form.OriginalUrl, string.IsNullOrWhiteSpace(form.ShortCode) ? null : form.ShortCode.Trim()), user);
            links = await Api.GetManagedLinksAsync(user);
            selected = links.FirstOrDefault(link => link.ShortCode == result.Link.ShortCode);
            ShowNotice(result.AlreadyExists ? "Link already exists" : "Link created",
                result.AlreadyExists ? "You already have short link " : "Short link ",
                result.Link.ShortCode,
                result.AlreadyExists ? "." : " is ready.",
                result.AlreadyExists ? "notice-info" : "notice-success");
        }
        catch (Exception ex) { HandleFailure(ex, "create managed link"); }
        finally { busy = false; }
    }

    private async Task ShowDetailsAsync(string shortCode)
    {
        busy = true;
        error = null;
        selected = null;
        try
        {
            var user = (await AuthenticationState).User;
            await Api.GetManagedLinkAsync(shortCode, user);
            selected = await Api.GetManagedAnalyticsAsync(shortCode, user);
        }
        catch (Exception ex) { HandleFailure(ex, "load link analytics"); }
        finally { busy = false; }
    }

    private void ShowNotice(string title, string messagePrefix, string shortCode, string messageSuffix, string kind)
    {
        noticeCancellation?.Cancel();
        noticeCancellation?.Dispose();
        notice = new(title, messagePrefix, shortCode, messageSuffix, kind);
        noticeDismissing = false;
        noticeCancellation = new CancellationTokenSource();
        _ = DismissAfterDelayAsync(notice, noticeCancellation.Token);
    }

    private async Task DismissAfterDelayAsync(ToastNotice shownNotice, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6.7), cancellationToken);
            await InvokeAsync(() =>
            {
                if (ReferenceEquals(notice, shownNotice))
                {
                    noticeDismissing = true;
                    StateHasChanged();
                }
            });
            await Task.Delay(TimeSpan.FromMilliseconds(300), cancellationToken);
            await InvokeAsync(() =>
            {
                if (ReferenceEquals(notice, shownNotice))
                {
                    notice = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException) { }
    }

    private void DismissNotice()
    {
        noticeCancellation?.Cancel();
        notice = null;
    }

    private sealed record ToastNotice(string Title, string MessagePrefix, string ShortCode, string MessageSuffix, string Kind);

    private void HandleFailure(Exception ex, string operation)
    {
        if (ex is ManagedReauthenticationRequiredException)
        {
            reauthRequired = true;
            liveUpdateError = false;
            links = null;
            selected = null;
            error = null;
        }
        else if (ex is ShortenerApiException or ManagedAccessUnavailableException)
            error = ex.Message;
        else
        {
            Logger.LogError("Managed UI operation failed. Operation={Operation} ExceptionType={ExceptionType}", operation, ex.GetType().Name);
            error = "Unable to complete this operation. Try again later.";
        }
    }

    private sealed class LinkForm
    {
        public string OriginalUrl { get; set; } = "";
        public string? ShortCode { get; set; }
    }
}
