@rendermode InteractiveServer
@implements IDisposable
@inject IdentityAvailability Identity
@inject WorkspaceNavigationState WorkspaceNavigation

<nav aria-label="Main navigation" class="site-nav @(WorkspaceNavigation.Workspaces.Count > 1 ? "has-workspaces" : null)">
    <a class="brand" href="/" aria-label="@($"{BrandText.Name} home")">
        <svg viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="9" cy="13" r="3.4" fill="none" stroke="#59E6CF" stroke-width="2.6"/>
            <path d="M16 13H38L12 35H33" fill="none" stroke="#59E6CF" stroke-width="5.2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="40" cy="35" r="4.2" fill="#F2BC68"/>
        </svg>
        <span>@BrandText.Name.ToLowerInvariant()</span>
    </a>
    @if (Identity.Customer && WorkspaceNavigation.Workspaces.Count > 1)
    {
        <div class="workspace-switcher">
            <label class="visually-hidden" for="workspace-select">Workspace</label>
            <select id="workspace-select" class="form-select" aria-label="Workspace" value="@WorkspaceNavigation.SelectedId" @onchange="SelectWorkspaceAsync">
                @foreach (var workspace in WorkspaceNavigation.Workspaces)
                {
                    <option value="@workspace.Id">@workspace.Name</option>
                }
            </select>
        </div>
    }
    <NavLink href="/" Match="NavLinkMatch.All">Guest link</NavLink>
    @if (Identity.Configured)
    {
        <AuthorizeView>
            <Authorized>
                <NavLink href="/dashboard">Managed links</NavLink>
                <form method="post" action="/account/signout"><AntiforgeryToken /><button class="nav-button" type="submit">Sign out</button></form>
            </Authorized>
            <NotAuthorized><a href="/account/signin">Sign in</a></NotAuthorized>
        </AuthorizeView>
    }
</nav>

@code {
    protected override void OnInitialized() => WorkspaceNavigation.Changed += Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private async Task SelectWorkspaceAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
            await WorkspaceNavigation.SelectAsync(id);
    }

    public void Dispose() => WorkspaceNavigation.Changed -= Refresh;
}
