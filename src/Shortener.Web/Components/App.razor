@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" style="background-color:#0B1426">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0B1426" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["fonts.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Shortener.Web.styles.css"]" />
    <ImportMap nonce="@nonce" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon.png" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script type="module" src="@Assets["copy-link.js"]"></script>
</body>

</html>

@code {
    private string? nonce;

    protected override void OnInitialized()
    {
        nonce = HttpContextAccessor.HttpContext?.Items["CspNonce"] as string;
    }
}
