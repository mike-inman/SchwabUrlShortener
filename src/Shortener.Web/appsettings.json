{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PublicLinks": { "BaseUrl": "https://localhost/" },
  "RateLimiting": {
    "Enabled": true,
    "GuestCreate": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Redirect": { "TokenLimit": 60, "TokensPerPeriod": 60, "ReplenishmentSeconds": 30 },
    "Managed": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "OpenTelemetry": { "SamplingRatio": 1.0, "ConsoleExporter": false },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "DataProtection": {
    "Mode": "Filesystem",
    "ApplicationName": "Shortener.Web"
  },
  "TokenCache": {
    "Mode": "InMemory"
  },
  "LiveUpdates": {
    "Mode": "Redis",
    "Channel": "shortener:links:v1",
    "DebounceMilliseconds": 1000
  }
}
