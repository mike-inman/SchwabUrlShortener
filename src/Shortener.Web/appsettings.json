{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "Mode": "Filesystem",
    "ApplicationName": "Shortener.Web"
  },
  "TokenCache": {
    "Mode": "InMemory"
  },
  "LiveUpdates": {
    "Mode": "Redis",
    "Channel": "shortener:links:v1",
    "DebounceMilliseconds": 1000
  }
}
