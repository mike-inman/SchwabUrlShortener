# Copy to a private mode-0600 file. Use a real API app registration client ID.
# Identity__Mode=Customer selects External ID. Omit it or use Workforce for the existing workforce path.
# Customer example (use these three values together):
# Identity__Mode=Customer
# AzureAd__Instance=https://schwaburlshortener.ciamlogin.com/
# AzureAd__TenantId=6adc36e9-dfe5-469f-8aed-6ef83abcdd19
# AzureAd__ClientId=8911f6b3-365c-4ce5-a0f7-d12b2e4f230a
AzureAd__ClientId=YOUR_REAL_API_APP_CLIENT_ID
ConnectionStrings__ShortenerDb=Host=postgres;Port=5432;Database=Schwab_test_local;Username=schwab_local;Password=YOUR_LOCAL_DATABASE_PASSWORD
ConnectionStrings__Redis=redis:6379,abortConnect=false
RedirectCache__Namespace=shortener:redirect:compose:
# Link Insights (Phase 1): base secret for the daily-rotating visitor-hash HMAC key.
# At least 32 random bytes. Never a real value in this example file; never logged or stored raw.
VisitorHash__DailySecret=YOUR_VISITOR_HASH_DAILY_SECRET
