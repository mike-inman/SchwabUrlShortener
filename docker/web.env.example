# Copy to a private mode-0600 file. ShortenerApi__BaseUrl is internal to Compose.
ShortenerApi__BaseUrl=http://api:8080
# Exact internal DNS hosts permitted for HTTP; only use this on the private Compose network.
ShortenerApi__AllowedInternalHttpHosts=api
# For guest-only setup, leave the AzureAd and scope lines absent until configured.
# Managed sign-in requires real provider settings and the HTTPS override.
# Customer example (set in a private file, not this template):
# Identity__Mode=Customer
# AzureAd__Authority=https://schwaburlshortener.ciamlogin.com/6adc36e9-dfe5-469f-8aed-6ef83abcdd19/v2.0
# AzureAd__TenantId=6adc36e9-dfe5-469f-8aed-6ef83abcdd19
# AzureAd__ClientId=93f2f816-0a95-41e0-b7df-7ca3c0cce8a0
# AzureAd__ClientSecret=INSTALL_PRIVATELY
# ShortenerApi__Scope=api://8911f6b3-365c-4ce5-a0f7-d12b2e4f230a/access_as_user
# AzureAd__CallbackPath=/signin-oidc
# AzureAd__SignedOutCallbackPath=/signout-callback-oidc
# ShortenerApi__Scope=api://YOUR_REAL_API_APP_CLIENT_ID/access_as_user
# AzureAd__Instance=https://login.microsoftonline.com/
# AzureAd__TenantId=YOUR_REAL_TENANT_ID
# AzureAd__ClientId=YOUR_REAL_WEB_APP_CLIENT_ID
# AzureAd__ClientSecret=YOUR_REAL_WEB_APP_CLIENT_SECRET
