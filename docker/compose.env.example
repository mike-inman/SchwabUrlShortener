# Copy to a private file outside the repository and replace paths and volume IDs.
# Existing installations must use their current volume names, not the defaults.
SCHWAB_POSTGRES_ENV_FILE=/absolute/private/path/postgres.env
SCHWAB_PG_VOLUME=schwab-url-shortener-pgdata
SCHWAB_REDIS_VOLUME=schwab-url-shortener-redis-data
SCHWAB_KAFKA_DATA_VOLUME=schwab-url-shortener-kafka-data
SCHWAB_KAFKA_SECRETS_VOLUME=schwab-url-shortener-kafka-secrets
SCHWAB_KAFKA_CONFIG_VOLUME=schwab-url-shortener-kafka-config
