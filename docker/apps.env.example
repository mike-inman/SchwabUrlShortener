# Copy to a private file outside the repository. Paths must be absolute.
SCHWAB_API_ENV_FILE=/absolute/private/path/api.env
SCHWAB_WEB_ENV_FILE=/absolute/private/path/web.env
SCHWAB_ANALYTICS_ENV_FILE=/absolute/private/path/analytics.env
# Change only after checking Docker networks and host routes.
SCHWAB_SUBNET=10.251.53.0/24
